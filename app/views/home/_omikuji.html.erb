<%# ログイン後のトップページに出す、今日の言葉 %>
<% word = word_of_the_day %>

<div class="row justify-content-center">
  <div class="col-12 col-lg-8">
    <div class="omikuji-card">
      <div class="text-center">
        <div class="omikuji-heading mb-1">今日の言葉</div>
        <div class="text-muted small mb-3"><%= l Date.current, format: "%Y年%-m月%-d日" %></div>

        <p class="omikuji-word mb-1"><%= word[:text] %></p>
        <% if word[:source] %>
          <p class="small text-muted mb-0">— <%= word[:source] %></p>
        <% end %>
      </div>

      <div class="text-center mt-3">
        <%# Turboのキャッシュで前回の言葉が一瞬見えるのを防ぐため、通常の遷移にする %>
        <%= link_to "🎋 次の言葉を見る", root_path,
                    class: "btn btn-sm btn-outline-danger",
                    data: { turbo: false } %>
      </div>
    </div>
  </div>
</div>
