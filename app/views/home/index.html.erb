<% if logged_in? %>
  <h1 class="h3 mb-4">ようこそ、<%= current_user.name %>さん</h1>

  <%# 続けられているかを一目で見せる。
      左に「続いた日数」と今週の曜日、右に数字を3つ並べる。
      日数だけを大きく置くのは、続けること自体を目当てにしてほしいため。 %>
  <section class="streak-panel mb-4">
    <div class="streak-main">
      <div class="streak-count">
        <span class="streak-number"><%= @streak %></span>
        <span class="streak-unit">日</span>
      </div>
      <p class="streak-caption mb-0">
        <% if @streak.zero? %>
          今日から始めましょう
        <% elsif @practiced_days.include?(Time.zone.today) %>
          続けています。今日も達成
        <% else %>
          続いています。今日はまだです
        <% end %>
      </p>

      <%# 今週の7日。塗られた丸が練習した日。 %>
      <ol class="week-strip" aria-label="今週の練習した日">
        <% @this_week.each do |day| %>
          <%
            done = @practiced_days.include?(day)
            today = day == Time.zone.today
            future = day > Time.zone.today
          %>
          <li class="week-day <%= "is-done" if done %> <%= "is-today" if today %> <%= "is-future" if future %>">
            <span class="week-day-label"><%= %w[月 火 水 木 金 土 日][day.wday == 0 ? 6 : day.wday - 1] %></span>
            <span class="week-day-dot" aria-hidden="true"></span>
            <span class="visually-hidden">
              <%= l(day, format: "%-m月%-d日") rescue day.strftime("%-m月%-d日") %>
              <%= done ? "練習しました" : "練習していません" %>
            </span>
          </li>
        <% end %>
      </ol>
    </div>

    <div class="streak-stats">
      <div class="streak-stat">
        <span class="streak-stat-number"><%= @attempts_this_week %></span>
        <span class="streak-stat-label">今週の問題</span>
      </div>
      <div class="streak-stat">
        <span class="streak-stat-number"><%= current_user.attempts.count %></span>
        <span class="streak-stat-label">通算</span>
      </div>
      <div class="streak-stat">
        <span class="streak-stat-number <%= "is-alert" if @review_count.positive? %>"><%= @review_count %></span>
        <span class="streak-stat-label">要復習</span>
      </div>
    </div>
  </section>

  <%# 何をやろうか迷わずに始められるよう、こちらから差し出す。
      なぜ勧められたのかを添える。理由が分からないまま出されると、
      選ばされている感じがして続かない。 %>
  <% if @recommendations.any? %>
    <section class="today-panel mb-4">
      <div class="d-flex justify-content-between align-items-baseline flex-wrap gap-2 mb-3">
        <h2 class="h5 mb-0">今日の練習</h2>
        <span class="today-note">忘れかけた頃のものと、まだ打っていないものから選びました</span>
      </div>

      <ol class="today-list">
        <% @recommendations.each do |item| %>
          <li class="today-item">
            <div class="today-item-body">
              <span class="today-title"><%= item.snippet.title %></span>
              <span class="today-reason <%= "is-review" if item.last_accuracy && item.last_accuracy < Attempt::REVIEW_THRESHOLD %>">
                <%= item.reason %>
              </span>
            </div>
            <%= link_to "練習する",
                        practice_snippet_path(item.snippet, level: item.level),
                        class: "btn btn-sm btn-success" %>
          </li>
        <% end %>
      </ol>
    </section>
  <% end %>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0">カテゴリから練習する</h2>
    <%= link_to "全てのコードを見る", snippets_path, class: "btn btn-sm btn-outline-secondary" %>
  </div>
  <div class="row g-3 mb-4">
    <% @categories.each do |category| %>
      <div class="col-12 col-md-4">
        <%= link_to category_path(category), class: "text-decoration-none" do %>
          <div class="card h-100">
            <div class="card-body">
              <h3 class="h6"><%= category.name %></h3>
              <p class="text-muted mb-0"><%= @snippet_counts[category.id].to_i %>個のコード</p>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @recent_attempts.any? %>
    <h2 class="h5 mb-3">最近の練習</h2>
    <ul class="list-group mb-4">
      <% @recent_attempts.each do |attempt| %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <span><%= attempt.snippet.title %>(<%= attempt.level_label %>)</span>
          <span class="badge <%= attempt.needs_review? ? 'bg-danger' : 'bg-success' %> rounded-pill">
            正答率<%= number_with_precision(attempt.accuracy, precision: 0) %>%
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= link_to "復習ページへ", attempts_path, class: "btn btn-outline-danger" %>

  <div class="mt-4">
    <%= render "omikuji" %>
  </div>
<% else %>
  <div class="text-center py-5">
    <h1 class="display-6 mb-3">重要なRailsコードを、打って覚える。</h1>
    <p class="lead text-muted mb-4">
      MVCの基本構文からActiveRecordクエリまで、実務でよく使うRailsコードをタイピング練習で体に覚えさせるアプリです。<br>
      優しい・普通・難しいの3段階で、自分のレベルに合わせて練習できます。
    </p>
    <div class="d-flex justify-content-center flex-wrap gap-2">
      <%= link_to "無料で始める", signup_path, class: "btn btn-primary btn-lg" %>
      <%# 登録もパスワード入力もせずに中を見てもらうための入り口 %>
      <%= button_to "ゲストログイン", guest_login_path, class: "btn btn-success btn-lg" %>
      <%= link_to "ログイン", login_path, class: "btn btn-outline-secondary btn-lg" %>
    </div>
    <%# 初めて来た人に一番見てほしい案内なので、色と太さで目立たせる %>
    <p class="top-trial-note mt-3 mb-0">
      (ゲストログインから、登録なしでそのままアプリをお試しできます)
    </p>
  </div>
<% end %>
