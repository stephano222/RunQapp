<%# 一覧に並べる1件分。コード一覧とカテゴリの画面の両方から使う。
    題名からは解説のページへ、右のボタンからはその場で練習へ入れる。
    先に解説を読みたいときと、すぐ打ち始めたいときの両方に応える。 %>
<div class="list-group-item">
  <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
      <h3 class="h6 mb-1">
        <%= link_to snippet.title, snippet_path(snippet) %>
        <% unless snippet.official? %>
          <span class="badge bg-info text-dark ms-1">自分で追加</span>
        <% end %>
      </h3>

      <% if best %>
        <span class="badge <%= best >= Attempt::REVIEW_THRESHOLD ? 'bg-success' : 'bg-danger' %>">
          自己ベスト <%= number_with_precision(best, precision: 0) %>%
        </span>
      <% else %>
        <span class="badge bg-secondary">未挑戦</span>
      <% end %>
    </div>

    <div class="d-flex align-items-center gap-2 flex-wrap">
      <span class="small text-muted">練習</span>
      <div class="btn-group btn-group-sm" role="group" aria-label="レベルを選んで練習">
        <%= link_to "優しい", practice_snippet_path(snippet, level: "easy"), class: "btn btn-outline-success" %>
        <%= link_to "普通", practice_snippet_path(snippet, level: "normal"), class: "btn btn-outline-warning" %>
        <%= link_to "難しい", practice_snippet_path(snippet, level: "hard"), class: "btn btn-outline-danger" %>
      </div>
    </div>
  </div>
</div>
