<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h1 class="h3 mb-0">コード一覧</h1>
  <%= link_to "＋ 自分のコードを追加", new_snippet_path, class: "btn btn-primary" %>
</div>

<%# 題名での絞り込み。件数が増えると目で追うのが難しくなるため。
    GETで送るので、絞った状態のURLをそのまま残せる。 %>
<%= form_with url: snippets_path, method: :get, data: { turbo: false },
              class: "snippet-search mb-4" do %>
  <div class="input-group">
    <%= text_field_tag :q, @keyword, class: "form-control",
                       placeholder: "題名で探す(例: バリデーション)",
                       aria: { label: "コードの題名で探す" } %>
    <%= submit_tag "探す", class: "btn btn-outline-secondary", name: nil %>
  </div>

  <% if @keyword.present? %>
    <div class="d-flex align-items-center gap-2 mt-2 flex-wrap">
      <span class="search-summary">
        「<%= @keyword %>」に一致するコード <strong><%= @result_count %></strong>件
      </span>
      <%= link_to "絞り込みを外す", snippets_path, class: "small" %>
    </div>
  <% end %>
<% end %>

<% if @keyword.present? && @result_count.zero? %>
  <div class="alert alert-warning">
    一致するコードがありませんでした。別の言葉でお試しください。
  </div>
<% end %>

<% @categories.each do |category| %>
  <% snippets = @snippets_by_category[category.id] || [] %>
  <% next if snippets.empty? %>
  <h2 class="h5 mt-4 mb-2"><%= category.name %></h2>
  <div class="list-group mb-3">
    <% snippets.each do |snippet| %>
      <%= render "snippets/row", snippet: snippet, best: @best_accuracy_by_snippet[snippet.id] %>
    <% end %>
  </div>
<% end %>
