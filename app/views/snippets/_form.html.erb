<% if snippet.errors.any? %>
  <div class="alert alert-danger">
    <ul class="mb-0">
      <% snippet.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: snippet, local: true do |f| %>
  <div class="mb-3">
    <%= f.label :category_id, "カテゴリ", class: "form-label" %>
    <%= f.collection_select :category_id, Category.all, :id, :name, { prompt: "選択してください" }, class: "form-select" %>
  </div>
  <div class="mb-3">
    <%= f.label :title, "タイトル", class: "form-label" %>
    <%= f.text_field :title, class: "form-control", required: true %>
  </div>
  <div class="mb-3">
    <%= f.label :code, "コード(このまま入力練習の対象になります)", class: "form-label" %>
    <%= f.text_area :code, class: "form-control", rows: 8, style: "font-family: monospace;", required: true %>
  </div>
  <div class="mb-3">
    <%= f.label :explanation, "解説(任意)", class: "form-label" %>
    <%= f.text_area :explanation, class: "form-control", rows: 4 %>
  </div>
  <%= f.submit "保存する", class: "btn btn-primary" %>
<% end %>
