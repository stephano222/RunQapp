<div class="row justify-content-center">
  <div class="col-12 col-lg-9">
    <h1 class="h3 mb-2">写経モード</h1>
    <p class="text-muted mb-4">
      写したいコードを貼り付けるだけで、すぐに写経を始められます。採点や記録はしません。
    </p>

    <%# Turboに任せると画面が差し替わらないため、通常のフォーム送信にする %>
    <%= form_with url: shakyo_path, method: :post, local: true, data: { turbo: false } do |f| %>
      <div class="mb-3">
        <%= f.label :title, "タイトル(任意)", class: "form-label" %>
        <%= f.text_field :title, class: "form-control", placeholder: "例: Userモデル" %>
      </div>

      <div class="mb-3">
        <%= f.label :code, "写経したいコード", class: "form-label" %>
        <%= f.text_area :code,
              class: "form-control",
              rows: 14,
              style: "font-family: monospace;",
              placeholder: "ここにコードを貼り付けてください",
              autofocus: true %>
      </div>

      <div class="mb-3">
        <label class="form-label">レベル</label>
        <div class="d-flex gap-3 flex-wrap">
          <div class="form-check">
            <%= f.radio_button :level, "easy", class: "form-check-input", checked: true %>
            <%= f.label :level_easy, "優しい(なぞる)", class: "form-check-label" %>
          </div>
          <div class="form-check">
            <%= f.radio_button :level, "normal", class: "form-check-input" %>
            <%= f.label :level_normal, "普通(ヒントあり)", class: "form-check-label" %>
          </div>
          <div class="form-check">
            <%= f.radio_button :level, "hard", class: "form-check-input" %>
            <%= f.label :level_hard, "難しい(ノーヒント)", class: "form-check-label" %>
          </div>
        </div>
      </div>

      <%= f.submit "写経をはじめる", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
