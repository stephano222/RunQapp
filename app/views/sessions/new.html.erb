<div class="row justify-content-center">
  <div class="col-12 col-md-6 col-lg-4">
    <h1 class="h3 mb-4">ログイン</h1>

    <%# 入力欄は空にしてある。試すだけならこちらから入れる %>
    <div class="alert alert-info py-2 small mb-3">
      登録せずに試すこともできます。
    </div>
    <%= button_to "ゲストログイン", guest_login_path,
                  class: "btn btn-success w-100 mb-4" %>

    <%= form_with url: login_path, method: :post, local: true do |f| %>
      <div class="mb-3">
        <%= f.label :email, "メールアドレス", class: "form-label" %>
        <%# autocomplete の指定で、ブラウザ自身の候補も出るようにしてある %>
        <%= f.email_field :email, value: @email, class: "form-control",
                                  required: true, autofocus: @email.blank?,
                                  autocomplete: "username" %>

        <%# 自動ではなくチェック式にする。共用の端末では、
            次に使う人にアドレスが見えてしまうため。 %>
        <div class="form-check mt-2">
          <%= check_box_tag :remember_email, "1", @remember, class: "form-check-input" %>
          <%= label_tag :remember_email, "このアドレスを次回も表示する", class: "form-check-label small" %>
        </div>
      </div>

      <div class="mb-3">
        <%= f.label :password, "パスワード", class: "form-label" %>
        <%= f.password_field :password, class: "form-control",
                                        required: true, autofocus: @email.present?,
                                        autocomplete: "current-password" %>
        <div class="form-text">
          パスワードは記憶しません。毎回入力してください。
        </div>
      </div>

      <%= f.submit "ログイン", class: "btn btn-primary w-100" %>
    <% end %>

    <p class="mt-3 text-center">
      アカウントをお持ちでない方は<%= link_to "新規登録", signup_path %>
    </p>
  </div>
</div>
