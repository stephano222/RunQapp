<div class="row justify-content-center">
  <div class="col-12 col-md-6 col-lg-4">
    <h1 class="h3 mb-4">ログイン</h1>

    <%# 入力欄は空にしてある。試すだけならこちらから入れる %>
    <div class="alert alert-info py-2 small mb-3">
      登録せずに試すこともできます。
    </div>
    <%= button_to "ゲストログイン", guest_login_path,
                  class: "btn btn-success w-100 mb-4" %>

    <%= form_with url: login_path, method: :post, local: true do |f| %>
      <div class="mb-3">
        <%= f.label :email, "メールアドレス", class: "form-label" %>
        <%= f.email_field :email, class: "form-control",
                                  required: true, autofocus: true, autocomplete: "username" %>
      </div>
      <div class="mb-3">
        <%= f.label :password, "パスワード", class: "form-label" %>
        <%= f.password_field :password, class: "form-control",
                                        required: true, autocomplete: "current-password" %>
      </div>
      <%= f.submit "ログイン", class: "btn btn-primary w-100" %>
    <% end %>

    <p class="mt-3 text-center">
      アカウントをお持ちでない方は<%= link_to "新規登録", signup_path %>
    </p>
  </div>
</div>
