<p><%= link_to "← 別のコードを和訳する", translate_path %></p>

<h1 class="h4 mb-3">和訳結果</h1>

<% if @translator.role %>
  <div class="card mb-4 border-primary">
    <div class="card-body">
      <div class="translation-label mb-2">このコードの役割</div>
      <p class="mb-0"><%= @translator.role %></p>
    </div>
  </div>
<% end %>

<div class="card mb-4">
  <div class="card-body">
    <div class="translation-label mb-2">全体の意味(要約)</div>
    <p class="mb-0"><%= @translator.summary %></p>
  </div>
</div>

<% if @translator.prose %>
  <div class="card mb-4">
    <div class="card-body">
      <div class="translation-label mb-2">全体の意味(通し訳)</div>
      <p class="mb-0"><%= @translator.prose %></p>
    </div>
  </div>
<% end %>

<div class="card mb-4">
  <div class="card-body">
    <div class="translation-label mb-3">1行ごとの意味</div>

    <% @translator.line_translations.each do |number, raw, meaning| %>
      <div class="translation-line">
        <span class="translation-lineno"><%= number %></span>
        <code class="translation-code"><%= raw.strip %></code>
        <% if meaning %>
          <span class="translation-meaning"><%= meaning %></span>
        <% else %>
          <span class="translation-unknown">(この行は自動で判断できませんでした)</span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<% if @translator.words.any? %>
  <div class="card mb-4">
    <div class="card-body">
      <div class="translation-label mb-3">出てくる英単語(<%= @translator.words.size %>語)</div>
      <div class="d-flex flex-wrap gap-2">
        <% @translator.words.each do |word, meaning| %>
          <span class="translation-word">
            <strong><%= word %></strong>
            <span class="text-muted"><%= meaning %></span>
          </span>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<div class="alert alert-secondary small">
  この和訳は辞書とパターンによる自動解析です。判断できない行はその旨を表示しています。
</div>
