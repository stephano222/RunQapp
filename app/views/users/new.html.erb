<div class="row justify-content-center">
  <div class="col-12 col-md-6 col-lg-4">
    <h1 class="h3 mb-4">新規登録</h1>

    <% if @user.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, url: signup_path, local: true do |f| %>
      <div class="mb-3">
        <%= f.label :name, "お名前", class: "form-label" %>
        <%= f.text_field :name, class: "form-control", required: true, autofocus: true %>
      </div>
      <div class="mb-3">
        <%= f.label :email, "メールアドレス", class: "form-label" %>
        <%= f.email_field :email, class: "form-control", required: true %>
      </div>
      <div class="mb-3">
        <%= f.label :password, "パスワード(6文字以上)", class: "form-label" %>
        <%= f.password_field :password, class: "form-control", required: true, minlength: 6 %>
      </div>
      <%= f.submit "登録する", class: "btn btn-primary w-100" %>
    <% end %>

    <p class="mt-3 text-center">
      すでにアカウントをお持ちの方は<%= link_to "ログイン", login_path %>
    </p>
  </div>
</div>
