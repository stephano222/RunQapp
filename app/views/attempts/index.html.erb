<h1 class="h3 mb-4">復習</h1>

<% if @summaries.empty? %>
  <p class="text-muted">まだ練習履歴がありません。<%= link_to "コード一覧", snippets_path %>から練習を始めましょう。</p>
<% else %>
  <% if @review_summaries.any? %>
    <h2 class="h5 mb-3 text-danger">要復習(正答率<%= Attempt::REVIEW_THRESHOLD.to_i %>%未満)</h2>
    <div class="list-group mb-4">
      <% @review_summaries.each do |summary| %>
        <div class="list-group-item">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
              <div class="fw-bold"><%= summary.snippet.title %></div>
              <span class="badge bg-secondary"><%= summary.snippet.category.name %></span>
              <span class="badge bg-danger">
                前回 <%= number_with_precision(summary.latest.accuracy, precision: 0) %>%(<%= summary.latest.level_label %>)
              </span>
            </div>
            <%= link_to "復習する",
                        practice_snippet_path(summary.snippet, level: summary.latest.level),
                        class: "btn btn-sm btn-danger" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-success">要復習のコードはありません。素晴らしい!</div>
  <% end %>

  <h2 class="h5 mb-3">練習履歴</h2>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th>コード</th>
          <th>カテゴリ</th>
          <th>挑戦回数</th>
          <th>最高正答率</th>
          <th>最終挑戦</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @summaries.each do |summary| %>
          <tr>
            <td><%= summary.snippet.title %></td>
            <td><%= summary.snippet.category.name %></td>
            <td><%= summary.try_count %></td>
            <td>
              <span class="badge <%= summary.best_accuracy >= Attempt::REVIEW_THRESHOLD ? 'bg-success' : 'bg-danger' %>">
                <%= number_with_precision(summary.best_accuracy, precision: 0) %>%
              </span>
            </td>
            <td class="text-muted small"><%= summary.latest.created_at.strftime("%Y/%m/%d %H:%M") %></td>
            <%# 解説は採点結果で読めるため、前回と同じレベルの練習へ直接入る %>
            <td>
              <%= link_to "練習",
                          practice_snippet_path(summary.snippet, level: summary.latest.level),
                          class: "btn btn-sm btn-outline-primary" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
