<!DOCTYPE html>
<html lang="ja">
  <head>
    <title>RunQの森 - Railsコードタイピング練習</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module", defer: true %>
  </head>

  <body>
    <svg class="forest-bg" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#fff6ea" />
          <stop offset="100%" stop-color="#eaf7ee" />
        </linearGradient>
      </defs>
      <rect x="0" y="0" width="1600" height="900" fill="url(#sky)" />

      <!-- 遠くの丘 -->
      <path d="M0,620 Q400,540 800,610 T1600,600 V900 H0 Z" fill="#d7ecd6" />
      <!-- 手前の丘 -->
      <path d="M0,700 Q420,600 850,690 T1600,680 V900 H0 Z" fill="#bfe3c0" />

      <!-- 森の木々 -->
      <g fill="#a9d6ad">
        <g transform="translate(120,560)"><circle r="55" /><circle cx="-45" cy="20" r="40" /><circle cx="45" cy="20" r="40" /><rect x="-8" y="50" width="16" height="40" fill="#c8a27a" /></g>
        <g transform="translate(320,600)"><circle r="45" /><circle cx="-38" cy="18" r="32" /><circle cx="38" cy="18" r="32" /><rect x="-7" y="42" width="14" height="34" fill="#c8a27a" /></g>
        <g transform="translate(1300,570)"><circle r="60" /><circle cx="-50" cy="22" r="42" /><circle cx="50" cy="22" r="42" /><rect x="-9" y="55" width="18" height="42" fill="#c8a27a" /></g>
        <g transform="translate(1480,610)"><circle r="42" /><circle cx="-34" cy="16" r="30" /><circle cx="34" cy="16" r="30" /><rect x="-6" y="40" width="12" height="32" fill="#c8a27a" /></g>
      </g>
      <g fill="#8fca97">
        <g transform="translate(220,650)"><circle r="50" /><circle cx="-42" cy="18" r="36" /><circle cx="42" cy="18" r="36" /><rect x="-8" y="48" width="16" height="36" fill="#b6926c" /></g>
        <g transform="translate(1400,660)"><circle r="48" /><circle cx="-40" cy="18" r="34" /><circle cx="40" cy="18" r="34" /><rect x="-8" y="46" width="16" height="34" fill="#b6926c" /></g>
      </g>

      <!-- 草むらの生き物たち(オリジナルデザイン) -->
      <g transform="translate(210,760)">
        <ellipse cx="0" cy="45" rx="70" ry="18" fill="rgba(0,0,0,0.06)" />
        <g class="critter-anim critter-anim-a">
          <circle cx="-22" cy="-38" r="14" fill="#fff7e6" />
          <circle cx="22" cy="-38" r="14" fill="#fff7e6" />
          <circle cx="-22" cy="-38" r="7" fill="#ffd8c2" />
          <circle cx="22" cy="-38" r="7" fill="#ffd8c2" />
          <ellipse cx="0" cy="0" rx="48" ry="42" fill="#fff7e6" />
          <circle class="eye" cx="-16" cy="-4" r="4" fill="#4a3f35" />
          <circle class="eye" cx="16" cy="-4" r="4" fill="#4a3f35" />
          <circle cx="-24" cy="10" r="8" fill="#ffd8c2" opacity="0.7" />
          <circle cx="24" cy="10" r="8" fill="#ffd8c2" opacity="0.7" />
          <path d="M-6,10 Q0,16 6,10" stroke="#4a3f35" stroke-width="2.5" fill="none" stroke-linecap="round" />
        </g>
      </g>

      <g transform="translate(1360,780) scale(0.85)">
        <ellipse cx="0" cy="45" rx="70" ry="18" fill="rgba(0,0,0,0.06)" />
        <g class="critter-anim critter-anim-b">
          <circle cx="-24" cy="-36" r="15" fill="#eaf2ff" />
          <circle cx="24" cy="-36" r="15" fill="#eaf2ff" />
          <ellipse cx="0" cy="0" rx="50" ry="44" fill="#eaf2ff" />
          <circle class="eye" cx="-16" cy="-2" r="4" fill="#4a3f35" />
          <circle class="eye" cx="16" cy="-2" r="4" fill="#4a3f35" />
          <circle cx="-24" cy="12" r="8" fill="#c9dcff" opacity="0.7" />
          <circle cx="24" cy="12" r="8" fill="#c9dcff" opacity="0.7" />
          <path d="M-6,12 Q0,18 6,12" stroke="#4a3f35" stroke-width="2.5" fill="none" stroke-linecap="round" />
        </g>
      </g>

      <!-- ノートPCでプログラミングする生き物 -->
      <g transform="translate(800,800) scale(0.95)">
        <ellipse cx="0" cy="78" rx="95" ry="20" fill="rgba(0,0,0,0.07)" />
        <g class="critter-anim critter-anim-c">
          <!-- 耳・頭・体 -->
          <circle cx="-26" cy="-42" r="16" fill="#fdeaf3" />
          <circle cx="26" cy="-42" r="16" fill="#fdeaf3" />
          <circle cx="-26" cy="-42" r="8" fill="#f9c9dc" opacity="0.7" />
          <circle cx="26" cy="-42" r="8" fill="#f9c9dc" opacity="0.7" />
          <ellipse cx="0" cy="0" rx="52" ry="46" fill="#fdeaf3" />
          <circle class="eye" cx="-17" cy="-8" r="4.5" fill="#4a3f35" />
          <circle class="eye" cx="17" cy="-8" r="4.5" fill="#4a3f35" />
          <circle cx="-25" cy="6" r="8" fill="#f9c9dc" opacity="0.7" />
          <circle cx="25" cy="6" r="8" fill="#f9c9dc" opacity="0.7" />
          <path d="M-7,8 Q0,14 7,8" stroke="#4a3f35" stroke-width="2.3" fill="none" stroke-linecap="round" />

          <!-- ノートPC -->
          <g transform="translate(0,46)">
            <rect x="-48" y="-4" width="96" height="10" rx="4" fill="#8a7566" />
            <rect x="-42" y="-48" width="84" height="46" rx="6" fill="#6b5747" />
            <rect x="-37" y="-43" width="74" height="34" rx="3" fill="#9fd8ff" />
            <rect class="code-line" x="-30" y="-35" width="42" height="4" rx="2" fill="#ffffff" opacity="0.9" />
            <rect class="code-line code-line-2" x="-30" y="-27" width="30" height="4" rx="2" fill="#ffffff" opacity="0.9" />
            <rect class="code-line code-line-3" x="-30" y="-19" width="48" height="4" rx="2" fill="#ffffff" opacity="0.9" />
          </g>

          <!-- タイピングする手 -->
          <ellipse class="paw paw-left" cx="-22" cy="42" rx="11" ry="8" fill="#fdeaf3" />
          <ellipse class="paw paw-right" cx="22" cy="42" rx="11" ry="8" fill="#fdeaf3" />
        </g>
      </g>
    </svg>

    <nav class="navbar navbar-expand-md navbar-dark bg-dark mb-4">
      <div class="container">
        <%= link_to "RunQの森", root_path, class: "navbar-brand" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <% if current_user %>
              <li class="nav-item"><%= link_to "コード一覧", snippets_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "復習", attempts_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "#{current_user.name}さん", edit_user_path, class: "nav-link" %></li>
              <li class="nav-item"><%= button_to "ログアウト", logout_path, method: :delete, class: "btn btn-link nav-link" %></li>
            <% else %>
              <li class="nav-item"><%= link_to "ログイン", login_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "新規登録", signup_path, class: "nav-link" %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <main class="container pb-5">
      <% flash.each do |type, message| %>
        <div class="alert alert-<%= type == "notice" ? "success" : "danger" %> alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
