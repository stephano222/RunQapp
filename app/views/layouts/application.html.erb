<!DOCTYPE html>
<html lang="ja">
  <head>
    <title>ルンダアプリ - Railsコードタイピング練習</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module", defer: true %>
  </head>

  <body>
    <nav class="navbar navbar-expand-md navbar-dark bg-dark mb-4">
      <div class="container">
        <%= link_to "ルンダアプリ", root_path, class: "navbar-brand" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <% if current_user %>
              <li class="nav-item"><%= link_to "コード一覧", snippets_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "復習", attempts_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "#{current_user.name}さん", edit_user_path, class: "nav-link" %></li>
              <li class="nav-item"><%= button_to "ログアウト", logout_path, method: :delete, class: "btn btn-link nav-link" %></li>
            <% else %>
              <li class="nav-item"><%= link_to "ログイン", login_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "新規登録", signup_path, class: "nav-link" %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <main class="container pb-5">
      <% flash.each do |type, message| %>
        <div class="alert alert-<%= type == "notice" ? "success" : "danger" %> alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
