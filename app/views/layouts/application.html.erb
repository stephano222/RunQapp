<!DOCTYPE html>
<html lang="ja">
  <head>
    <title>RunQの森 - Railsコードタイピング練習</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module", defer: true %>
  </head>

  <body>
    <%# 背景はどのページでも時刻に合わせて変わる。
        ログイン前は鮮明な写真、ログイン後は学習に集中できるよう透明化版を使う %>
    <% background_image = background_image_for_now(vivid: !logged_in?) %>
    <div class="forest-bg" aria-hidden="true" style="background-image: url('<%= image_path(background_image) %>');"></div>

    <nav class="navbar navbar-expand-md navbar-dark bg-dark mb-4">
      <%# 時計を画面の右端まで寄せるため、ナビバーだけ全幅にする %>
      <div class="container-fluid px-3 position-relative">
        <%= link_to "RunQの森", root_path, class: "navbar-brand me-0" %>

        <%# 折りたたみメニューの外に置き、スマホでも常に見えるようにする。
            位置はCSSでヘッダーの中央に固定している %>
        <span id="navbar-clock" class="navbar-text navbar-clock"></span>

        <%# BGM。自動再生はブラウザに止められるため、押して始める形にしている %>
        <button type="button" id="bgm-toggle" class="btn btn-sm btn-outline-light bgm-button me-2"></button>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <% if current_user %>
              <%# アプリ名からも戻れるが、それと気づきにくい。
                  練習の途中からいつでも最初の画面に戻れるよう、メニューにも並べる %>
              <li class="nav-item"><%= link_to "ホーム", root_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "コード一覧", snippets_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "写経", shakyo_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "和訳", translate_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "復習", attempts_path, class: "nav-link" %></li>
              <% if current_user.admin? %>
                <li class="nav-item"><%= link_to "利用状況", admin_dashboard_path, class: "nav-link" %></li>
              <% end %>
              <li class="nav-item"><%= link_to "#{current_user.name}さん", edit_user_path, class: "nav-link" %></li>
              <li class="nav-item"><%= button_to "ログアウト", logout_path, method: :delete, class: "btn btn-link nav-link" %></li>
            <% else %>
              <li class="nav-item"><%= link_to "ログイン", login_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "新規登録", signup_path, class: "nav-link" %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <main class="container pb-5">
      <% flash.each do |type, message| %>
        <div class="alert alert-<%= type == "notice" ? "success" : "danger" %> alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
